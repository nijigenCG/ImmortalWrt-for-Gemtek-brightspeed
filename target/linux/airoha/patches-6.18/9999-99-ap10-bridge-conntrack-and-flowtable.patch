 static enum flow_offload_xmit_type nft_xmit_type(struct dst_entry *dst)
 {
@@ -326,6 +328,11 @@
 		}
 
 		nft_br_vlan_dev_fill_forward_path(pkt, &ctx);
+		if (ft->data.type->family == NFPROTO_BRIDGE && ctx.num_vlans) {
+			info.encap[0].id = ctx.vlan[0].id;
