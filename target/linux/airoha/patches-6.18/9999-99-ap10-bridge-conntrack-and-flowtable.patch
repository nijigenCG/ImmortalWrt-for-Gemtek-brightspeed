+/* Native bridge hooks have no L3 route. A temporary bridge dst provides
+ * MTU/path discovery only; successful paths are always DIRECT and release
+ * these references in flow_offload_route_init().
+ */
+static int nft_flow_route_bridge_native(const struct nft_pktinfo *pkt,
+				       const struct nf_conn *ct,
+				       struct nf_flow_route *route,
+				       enum ip_conntrack_dir dir,
+				       struct nft_flowtable *ft)
+{
+	struct dst_entry *dst = NULL;
+	struct net_device *master;
+	int i;
+
+	if (!skb_mac_header_was_set(pkt->skb) ||
+	    !nft_flow_offload_is_bridging(pkt->skb))
+		return -ENOENT;
+
+	rcu_read_lock();
+	master = netdev_master_upper_dev_get_rcu(pkt->skb->dev);
+	if (master && netif_is_bridge_master(master)) {
+		switch (ct->tuplehash[dir].tuple.src.l3num) {
+		case NFPROTO_IPV4: {
+			struct rtable *rt;
+
+			rt = rt_dst_alloc(master, 0, RTN_UNICAST, true);
+			dst = rt ? &rt->dst : NULL;
+			break;
+		}
+		case NFPROTO_IPV6: {
+			struct rt6_info *rt;
+
+			rt = ip6_dst_alloc(nft_net(pkt), master, 0);
+			dst = rt ? &rt->dst : NULL;
+			break;
+		}
+		}
+	}
+	rcu_read_unlock();
+	if (!dst)
+		return -ENOENT;
+
+	dst_hold(dst);
+	nft_default_forward_path(route, dst, dir);
+	nft_default_forward_path(route, dst, !dir);
+	if (nft_dev_forward_path(pkt, route, ct, dir, ft) ||
+	    nft_dev_forward_path(pkt, route, ct, !dir, ft))
+		goto err;
+
+	for (i = 0; i < IP_CT_DIR_MAX; i++) {
+		/* Encapsulation that cannot be reproduced exactly stays on the
+		 * regular bridge path. In particular do not pop QinQ/PPPoE and
+		 * restore only one tag in the native bridge fast path.
+		 */
+		if (route->tuple[i].xmit_type != FLOW_OFFLOAD_XMIT_DIRECT ||
+		    route->tuple[i].in.num_encaps > 1 ||
+		    (route->tuple[i].in.num_encaps &&
+		     route->tuple[i].in.encap[0].proto != htons(ETH_P_8021Q) &&
+		     route->tuple[i].in.encap[0].proto != htons(ETH_P_8021AD)))
+			goto err;
+	}
+	return 0;
+err:
+	dst_release(dst);
+	dst_release(dst);
+	return -ENOENT;
+}
+
 int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
 		   struct nf_flow_route *route, enum ip_conntrack_dir dir,
 		   struct nft_flowtable *ft)
 {
+	if (ft->data.type->family == NFPROTO_BRIDGE)
+		return nft_flow_route_bridge_native(pkt, ct, route, dir, ft);
+
 	if (nft_flow_offload_is_bridging(pkt->skb))
 		return nft_flow_route_bridging(pkt, ct, route, dir, ft);
 
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -17,6 +17,7 @@
 #include <net/netfilter/nf_conntrack_core.h>
 #include <net/netfilter/nf_conntrack_extend.h>
 #include <net/netfilter/nf_flow_table.h>
+#include <net/netfilter/nf_conntrack_brxing.h>
 
 struct nft_flow_offload {
 	struct nft_flowtable	*flowtable;
@@ -84,12 +85,82 @@
 	spin_unlock_bh(&ct->lock);
 }
 
+/* Record the ingress port of each crossing of a bridged connection, see
+ * struct nf_conn_brxing. Runs for every packet that reaches the bridge
+ * forward chain, i.e. every packet not handled by the fast path.
+ */
+static void nft_flow_offload_bridge_record(const struct nft_pktinfo *pkt,
+					   struct nf_flowtable *flowtable,
+					   struct nf_conn *ct,
+					   enum ip_conntrack_info ctinfo)
+{
+	enum ip_conntrack_dir dir = CTINFO2DIR(ctinfo);
+	u8 proto = ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum;
+	struct nf_conn_brxing *rec;
+	int iif, old;
+
+	if ((proto != IPPROTO_TCP && proto != IPPROTO_UDP) || !nft_in(pkt))
+		return;
+
+	iif = nft_in(pkt)->ifindex;
+	rec = nf_conn_brxing_find(ct);
+	if (!rec) {
+		/* Extensions can only be added before confirmation. A
+		 * connection first seen here after that (e.g. picked up
+		 * mid-stream) has no record and is never offloaded.
+		 */
+		if (nf_ct_is_confirmed(ct))
+			return;
+		rec = nf_ct_ext_add(ct, NF_CT_EXT_BRXING, GFP_ATOMIC);
+		if (!rec)
+			return;
+	}
+
+	old = cmpxchg(&rec->iif[dir], 0, iif);
+	if (!old || old == iif || READ_ONCE(rec->multi))
+		return;
+
+	WRITE_ONCE(rec->multi, true);
+
+	/* Offloaded before the other crossing was seen (e.g. UDP with both
+	 * ends sending at once): let the flowtable GC tear it down now, see
+	 * nf_flow_bridge_gc().
+	 */
+	if (test_bit(IPS_OFFLOAD_BIT, &ct->status))
+		mod_delayed_work(system_power_efficient_wq,
+				 &flowtable->gc_work, 0);
+}
+
+/* Offload a bridged connection only if it crossed the bridge once. For UDP,
+ * wait for a reply: by then the first packet has made all its crossings.
+ * For TCP the handshake has, as offload requires an established connection.
+ */
+static bool nft_flow_offload_bridge_ok(const struct nf_conn *ct)
+{
+	const struct nf_conn_brxing *rec = nf_conn_brxing_find(ct);
+	u8 proto = ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum;
+
+	if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+		return true;
+
+	if (!rec || READ_ONCE(rec->multi))
+		return false;
+
+	if (proto == IPPROTO_UDP &&
+	    !test_bit(IPS_SEEN_REPLY_BIT, &ct->status))
+		return false;
+
+	return true;
+}
+
+
 static void nft_flow_offload_eval(const struct nft_expr *expr,
 				  struct nft_regs *regs,
 				  const struct nft_pktinfo *pkt)
 {
 	struct nft_flow_offload *priv = nft_expr_priv(expr);
 	struct nf_flowtable *flowtable = &priv->flowtable->data;
+	bool routing = flowtable->type->family != NFPROTO_BRIDGE;
 	struct tcphdr _tcph, *tcph = NULL;
 	struct nf_flow_route route = {};
 	enum ip_conntrack_info ctinfo;
@@ -106,6 +177,9 @@
 	if (!ct)
 		goto out;
 
+	if (!routing)
+		nft_flow_offload_bridge_record(pkt, flowtable, ct, ctinfo);
+
 	switch (ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum) {
 	case IPPROTO_TCP:
 		thoff = nft_thoff(pkt);
@@ -146,6 +220,13 @@
 		goto out;
 
 	if (!nf_ct_is_confirmed(ct))
+		goto out;
+
+	if (!routing && (!nft_flow_offload_bridge_ok(ct) ||
+			 ct->status & IPS_NAT_MASK))
+		goto out;
+
+	if (!routing && tcp_not_established)
 		goto out;
 
 	if (test_and_set_bit(IPS_OFFLOAD_BIT, &ct->status))
@@ -201,6 +282,7 @@
 
 	if (ctx->family != NFPROTO_IPV4 &&
 	    ctx->family != NFPROTO_IPV6 &&
+	    ctx->family != NFPROTO_BRIDGE &&
 	    ctx->family != NFPROTO_INET)
 		return -EOPNOTSUPP;
 
