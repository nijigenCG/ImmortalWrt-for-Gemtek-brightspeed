+pure_ap_profile() {
+	[ -f /usr/share/airoha/xr1710g-pure-ap ] || return 1
+	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
+		gemtek,xr1710g|gemtek,xr1710g-ubi) return 0 ;;
+		*) return 1 ;;
+	esac
+}
+
+pure_ap_map=/sys/module/mt7996e/parameters/npu_tx_band_map
+pure_ap_bridge=/etc/init.d/bridger
+
+pure_ap_bridge_running() {
+	[ "$("$pure_ap_bridge" status 2>/dev/null)" = running ]
+}
+
+pure_ap_radio_channels() {
+	iw dev 2>/dev/null | awk '
+		$1 == "Interface" { ap=0 }
+		$1 == "type" { ap=($2 == "AP") }
+		ap && $1 == "channel" && $2 ~ /^[0-9]+$/ && $5 == "width:" && $6 ~ /^[0-9]+$/ {
+			frequency=$3
+			sub(/^\(/, "", frequency)
+			if (frequency !~ /^[0-9]+$/) next
+			band=(frequency >= 5925 ? 2 : frequency >= 5000 ? 1 : 0)
+			channel[band]=$2
+			width[band]=$6
+		}
+		END {
+			printf "["
+			for (i=0; i<3; i++) {
+				if (i) printf ","
+				if (i in channel) printf "{\"channel\":%d,\"width\":%d}", channel[i], width[i]
+				else printf "null"
+			}
+			printf "]"
+		}'
+}
+
+get_pure_ap_status() {
+	if ! pure_ap_profile; then
+		echo '{"supported":false}'
+		return
+	fi
+	local running=false map bridge_port=false bridge_available=false map_available=false
+	[ -x "$pure_ap_bridge" ] && bridge_available=true
+	pure_ap_bridge_running && running=true
+	map=$(cat "$pure_ap_map" 2>/dev/null)
+	case "$map" in
+		0|1|2) [ -w "$pure_ap_map" ] && map_available=true ;;
+		*) map=null ;;
+	esac
+	[ -e /sys/class/net/br-lan/brif/wan ] && bridge_port=true
+	printf '{"supported":true,"bridger_running":%s,"bridger_available":%s,"tx_map":%s,"map_available":%s,"wan_in_bridge":%s,"radios":%s}\n' \
+		"$running" "$bridge_available" "$map" "$map_available" "$bridge_port" "$(pure_ap_radio_channels)"
+}
+
+pure_ap_wait_bridge() {
+	local desired="$1" attempt
+	for attempt in 1 2 3; do
+		if pure_ap_bridge_running; then
+			[ "$desired" = 1 ] && return 0
+		else
+			[ "$desired" = 0 ] && return 0
+		fi
+		sleep 1
+	done
+	return 1
+}
+
+set_pure_ap_offload() (
+	local control value previous action
+	pure_ap_profile || { echo '{"error":"unsupported_profile"}'; return; }
+	control=$(printf '%s' "$1" | jsonfilter -e '@.control')
+	value=$(printf '%s' "$1" | jsonfilter -e '@.value')
+	case "$control:$value" in
+		bridger:0|bridger:1|tx_map:0|tx_map:1|tx_map:2) ;;
+		*) echo '{"error":"invalid_setting"}'; return ;;
+	esac
+	local lockfile=/var/lock/airoha-pure-ap-offload
+	lock -n "$lockfile" || { echo '{"error":"busy"}'; return; }
+	trap 'lock -u "$lockfile"' EXIT
+	trap 'exit 1' HUP INT TERM
+
+	if [ "$control" = bridger ]; then
+		[ -x "$pure_ap_bridge" ] || { echo '{"error":"bridger_unavailable"}'; return; }
+		action=stop
+		[ "$value" = 1 ] && action=start
+		if ! "$pure_ap_bridge" "$action" >/dev/null 2>&1 || ! pure_ap_wait_bridge "$value"; then
+			echo '{"error":"bridger_action_failed"}'
+			return
+		fi
+	else
+		previous=$(cat "$pure_ap_map" 2>/dev/null)
+		case "$previous" in
+			0|1|2) ;;
+			*) echo '{"error":"map_unavailable"}'; return ;;
+		esac
+		if [ "$value" != "$previous" ]; then
+			if ! printf '%s\n' "$value" > "$pure_ap_map" || [ "$(cat "$pure_ap_map")" != "$value" ]; then
+				echo '{"error":"map_write_failed"}'
+				return
+			fi
+			# A live bridger may still have flows installed for the old map.
+			if pure_ap_bridge_running &&
+				{ ! "$pure_ap_bridge" restart >/dev/null 2>&1 || ! pure_ap_wait_bridge 1; }; then
+				if ! printf '%s\n' "$previous" > "$pure_ap_map" || [ "$(cat "$pure_ap_map")" != "$previous" ] ||
+					! "$pure_ap_bridge" restart >/dev/null 2>&1 || ! pure_ap_wait_bridge 1; then
+					echo '{"error":"rollback_failed"}'
+				else
+					echo '{"error":"bridger_restart_failed"}'
+				fi
+				return
+			fi
+		fi
+	fi
+	get_pure_ap_status
+)
