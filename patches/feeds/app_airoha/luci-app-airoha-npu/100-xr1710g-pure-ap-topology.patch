diff --git a/luci-app-airoha-npu/htdocs/luci-static/resources/view/airoha_npu/pure-ap.css b/luci-app-airoha-npu/htdocs/luci-static/resources/view/airoha_npu/pure-ap.css
new file mode 100644
index 0000000..866ca23
--- /dev/null
+++ b/luci-app-airoha-npu/htdocs/luci-static/resources/view/airoha_npu/pure-ap.css
@@ -0,0 +1,152 @@
+.pure-ap-board {
+	color-scheme: light dark;
+	--pap-bg: var(--background-color-high, light-dark(#fcfefd, #1c2824));
+	--pap-case: light-dark(#dce7df, #25352d);
+	--pap-board: light-dark(#e3efe6, #172921);
+	--pap-border: light-dark(#a7bdb0, #516e5f);
+	--pap-copper: light-dark(#957543, #b99b64);
+	--pap-accent: light-dark(#1b624a, #9bdfbc);
+	--pap-active: light-dark(#d7ede0, #234031);
+	--pap-rf: light-dark(#e3eef7, #203541);
+	--pap-rf-line: light-dark(#46738d, #8fbcd7);
+	--pap-socket: light-dark(#354a40, #0b1710);
+	margin-block-end: 1rem;
+}
+
+.pure-ap-board h3, .pure-ap-board h4 { margin: 0 0 .5rem; }
+.pap-controls, .pap-grid, .pap-lanes { display: grid; gap: .5rem; }
+.pap-controls, .pap-lanes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.pap-controls label {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: .5rem;
+	padding: .5rem .65rem;
+	border: 1px solid var(--pap-border);
+	border-radius: .35rem;
+}
+.pap-controls select { min-width: 0; max-width: 55%; }
+.pap-caption { font-size: .875rem; margin: .4rem 0 .75rem; }
+.pap-board {
+	padding: .8rem 1rem 1rem;
+	background: radial-gradient(circle, var(--pap-border) .65px, transparent .9px) 6px 6px / 13px 13px, var(--pap-board);
+	border: 1px solid var(--pap-border);
+	border-radius: 1.2rem;
+	box-shadow: inset 0 0 0 4px var(--pap-case), 0 3px 0 var(--pap-case);
+}
+.pap-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.pap-node {
+	display: grid;
+	grid-template: "icon title" auto "count count" 1fr / auto minmax(0, 1fr);
+	align-items: start;
+	gap: .15rem .35rem;
+	min-width: 0;
+	min-height: 44px;
+	padding: .4rem .5rem;
+	text-align: start;
+	color: inherit;
+	background: var(--pap-bg);
+	border: 1px solid var(--pap-border);
+	border-radius: .3rem;
+	overflow-wrap: anywhere;
+}
+.pap-node[aria-pressed=true] { outline: 2px solid var(--pap-accent); outline-offset: -2px; }
+.pap-node:focus-visible { outline: 2px solid var(--pap-accent); outline-offset: 2px; }
+.pap-node strong { grid-area: title; }
+.pap-node small { grid-area: count; font-variant-numeric: tabular-nums; }
+.pap-node small.pap-tx { grid-area: auto / 1 / auto / -1; color: var(--pap-rf-line); }
+.pap-node-jack {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	text-align: center;
+	background: var(--pap-case);
+	box-shadow: inset 0 -2px 0 var(--pap-border);
+}
+.pap-icons, .pap-package h4 { display: flex; align-items: center; gap: .3rem; }
+.pap-icons { grid-area: icon; }
+.pap-icon { position: relative; display: inline-block; flex: none; width: .85rem; height: .75rem; color: var(--pap-accent); }
+.pap-icon-chip, .pap-icon-buffer, .pap-icon-probe {
+	border: 1px solid currentColor;
+	border-radius: 2px;
+	background: repeating-linear-gradient(0deg, transparent 0 2px, currentColor 2px 3px, transparent 3px 4px);
+}
+.pap-icon-path { height: .55rem; border-block: 1px solid currentColor; }
+.pap-icon-path::after {
+	content: ""; position: absolute; inset: -.17rem 0 auto auto; width: .32rem; height: .32rem;
+	border-block-start: 1px solid currentColor; border-inline-end: 1px solid currentColor; transform: rotate(45deg);
+}
+.pap-icon-radio {
+	color: var(--pap-rf-line);
+	border-radius: 50%;
+	border-block-start: 2px solid currentColor;
+	background: radial-gradient(circle at 50% 65%, currentColor 0 1px, transparent 1.4px);
+}
+.pap-icon-lock { width: .65rem; height: .55rem; margin-top: .25rem; border: 1px solid currentColor; border-radius: 2px; }
+.pap-icon-lock::before { content: ""; position: absolute; inset: -.29rem .07rem auto; height: .29rem; border: 1px solid currentColor; border-bottom: 0; border-radius: 50% 50% 0 0; }
+.pap-icon-jack {
+	width: 1.65rem;
+	height: 1.4rem;
+	border: 1px solid var(--pap-border);
+	border-radius: 3px;
+	background: var(--pap-case);
+}
+.pap-icon-jack::before {
+	content: ""; position: absolute; inset: 4px 3px 3px; background: var(--pap-socket);
+	clip-path: polygon(0 0,100% 0,100% 71%,68% 71%,68% 100%,32% 100%,32% 71%,0 71%);
+}
+.pap-icon-jack::after {
+	content: ""; position: absolute; inset: 5px 6px auto; height: 3px;
+	background: repeating-linear-gradient(90deg, var(--pap-copper) 0 1px, transparent 1px 2px);
+}
+.pap-traces > div, .pap-lanes > div {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	justify-content: center;
+	min-width: 0;
+}
+.pap-traces .pap-wire-uplink, .pap-traces > div:last-child .pap-wire { height: 2.1rem; }
+.pap-wire { width: 0; height: .65rem; border-inline-start: 1px solid var(--pap-copper); }
+.pap-wire-radio { border-color: var(--pap-rf-line); }
+.pap-route-label { padding-inline: .25rem; background: var(--pap-board); font-size: .75rem; text-align: center; }
+.pap-package {
+	position: relative;
+	padding: .5rem;
+	border: 1px solid var(--pap-border);
+	border-radius: .35rem;
+	background: var(--pap-case);
+}
+.pap-package::before, .pap-package::after {
+	content: ""; position: absolute; inset: 10px auto 10px -5px; width: 4px;
+	background: repeating-linear-gradient(0deg, var(--pap-copper) 0 2px, transparent 2px 6px);
+	pointer-events: none;
+}
+.pap-package::after { inset-inline: auto -5px; }
+.pap-package .pap-grid + .pap-grid { margin-block-start: .45rem; }
+.pap-observations { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.pap-node-probe { border-style: dashed; }
+.pap-lanes { max-width: 32rem; width: 75%; margin-inline: auto; }
+.pap-lanes .pap-node { width: 100%; }
+.pap-lanes .pap-node, .pap-radio { background: var(--pap-rf); }
+.pap-link-up .pap-wire-uplink { border-color: var(--pap-accent); border-width: 2px; }
+.pap-link-up .pap-port-row .pap-node:nth-child(2),
+.pap-offload-active .pap-package .pap-grid:nth-of-type(2) .pap-node:nth-child(2) { background: var(--pap-active); }
+.pap-inspector {
+	margin-top: .75rem;
+	padding: .6rem .75rem;
+	border-inline-start: 3px solid var(--pap-accent);
+	background: var(--pap-bg);
+}
+.pap-inspector p { margin: .2rem 0; }
+.pap-inspector-value { font-variant-numeric: tabular-nums; }
+.pap-advanced { margin-block: .75rem; }
+.pap-advanced summary { cursor: pointer; font-weight: 600; padding-block: .5rem; }
+@media (max-width: 600px) {
+	.pap-controls, .pap-observations { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+	.pap-controls { grid-template-columns: 1fr; }
+	.pap-board { padding: .55rem; }
+	.pap-node { padding: .3rem; column-gap: .15rem; }
+	.pap-lanes { width: 90%; }
+	.pap-icon-jack { width: 1.3rem; }
+}
diff --git a/luci-app-airoha-npu/htdocs/luci-static/resources/view/airoha_npu/pure_ap.js b/luci-app-airoha-npu/htdocs/luci-static/resources/view/airoha_npu/pure_ap.js
new file mode 100644
index 0000000..c0db5be
--- /dev/null
+++ b/luci-app-airoha-npu/htdocs/luci-static/resources/view/airoha_npu/pure_ap.js
@@ -0,0 +1,277 @@
+'use strict';
+'require baseclass';
+'require rpc';
+'require ui';
+
+var callStatus = rpc.declare({ object: 'luci.airoha_npu', method: 'getPureApStatus' });
+var callSet = rpc.declare({
+	object: 'luci.airoha_npu', method: 'setPureApOffload', params: ['control', 'value']
+});
+var lanes = [
+	[[0], [1, 2]],
+	[[2], [0, 1]],
+	[[1, 2], [0]]
+];
+var bands = ['2.4', '5', '6'];
+var descriptions = {
+	gsw: ['LAN3 / LAN4', _('The two 1 GbE ports share the internal switch.')],
+	wan: ['10G WAN', _('Physical 10 GbE port. The link label shows whether it belongs to br-lan.')],
+	lan2: ['10G LAN2', _('The second 10 GbE port uses GDM4.')],
+	gdm1: ['GDM1', _('Counts frames on the internal switch link, even when the external LAN ports are unplugged.')],
+	gdm2: ['GDM2', _('Counts frames received from and sent to the 10G WAN port.')],
+	gdm4: ['GDM4', _('Counts frames on 10G LAN2. Cumulative drops can remain after unplugging it.')],
+	pse: ['PSE', _('Hardware buffer for short traffic bursts. Current use and historical peak are separate.')],
+	ppe: ['PPE', _('Hardware forwarder for eligible wired-to-wireless flows. BND counts entries bound in hardware.')],
+	npu: ['NPU', _('Network processing engine. The two PCIe labels below show transmit offload mapping.')],
+	cdm1: ['CDM1', _('Measures CPU and hardware forwarding on the internal switch side.')],
+	cdm2: ['CDM2', _('Measures CPU and hardware forwarding on the uplink side. The dedicated fast-path counter is separate.')],
+	cpu: ['CPU', _('Handles device management and packets that need software processing.')],
+	crypto: ['EIP93', _('Accelerates local cryptography. Zero active sessions is normal for ordinary bridging. Wi-Fi encryption is handled by the wireless subsystem.')],
+	pcie0: ['PCIe0 · Gen3 ×2', _('Physical link to the MT7996. The band label applies to NPU transmit offload.')],
+	pcie2: ['PCIe2 · Gen2 ×1', _('Physical link to the MT7996. The band label applies to NPU transmit offload.')],
+	radio0: ['2.4 GHz', _('The retry indicator uses cumulative driver counters for associated clients. It is not a packet loss rate.')],
+	radio1: ['5 GHz', _('The retry indicator uses cumulative driver counters for associated clients. It is not a packet loss rate.')],
+	radio2: ['6 GHz', _('The retry indicator uses cumulative driver counters for associated clients. It is not a packet loss rate.')]
+};
+
+function num(value) {
+	return typeof value === 'number' && isFinite(value) ? value.toLocaleString() : '—';
+}
+
+function ratio(numerator, total) {
+	return total > 0 ? (100 * numerator / total).toFixed(1) + '%' : '—';
+}
+
+function nodeIcon(kind) {
+	return E('span', { 'class': 'pap-icon pap-icon-' + kind, 'aria-hidden': 'true' });
+}
+
+function portState(port) {
+	if (!port || port.present === false) return '—';
+	if (port.carrier === 0) return _('Link down');
+	if (port.carrier !== 1) return '—';
+	if (!(port.speed_mbps > 0)) return _('Link up');
+	return (port.speed_mbps >= 1000 ? (port.speed_mbps / 1000) + ' Gb/s' : port.speed_mbps + ' Mb/s') +
+		(port.duplex === 'full' ? ' · ' + _('Full duplex') : '');
+}
+
+function create(initialStatus) {
+	var status = initialStatus;
+	var ready = true, pending = false, generation = 0;
+	var selected = 'ppe', metrics = {}, nodes = {};
+	var selectedTitle = E('strong');
+	var selectedText = E('p');
+	var selectedValue = E('div', { 'class': 'pap-inspector-value' });
+	var bridgeInput = E('input', { 'type': 'checkbox', 'role': 'switch' });
+	var mapInput = E('select', {}, [
+		E('option', { 'value': '' }, _('Unavailable')),
+		E('option', { 'value': '0' }, _('Original mapping')),
+		E('option', { 'value': '1' }, _('6 GHz preferred')),
+		E('option', { 'value': '2' }, _('5 / 6 GHz preferred'))
+	]);
+	mapInput.options[0].disabled = true;
+
+	function updateSelection() {
+		selectedTitle.textContent = descriptions[selected][0];
+		selectedText.textContent = descriptions[selected][1];
+		selectedValue.textContent = metrics[selected] || '—';
+		Object.keys(nodes).forEach(function(key) {
+			nodes[key].button.setAttribute('aria-pressed', key === selected ? 'true' : 'false');
+		});
+	}
+
+	function node(key, kind, title, doubleJack) {
+		var value = E('small', {}, '—');
+		var icon = E('span', { 'class': 'pap-icons', 'aria-hidden': 'true' },
+			doubleJack ? [nodeIcon(kind), nodeIcon(kind)] : [nodeIcon(kind)]);
+		var button = E('button', { 'type': 'button', 'class': 'pap-node pap-node-' + kind }, [
+			icon, E('strong', {}, title || descriptions[key][0]), value
+		]);
+		var tx = kind === 'radio' ? E('small', { 'class': 'pap-tx' }) : null;
+		if (tx) button.appendChild(tx);
+		button.addEventListener('click', function() {
+			selected = key;
+			updateSelection();
+		});
+		nodes[key] = { button: button, value: value, tx: tx };
+		return button;
+	}
+
+	function wire(kind) {
+		return E('span', { 'aria-hidden': 'true', 'class': 'pap-wire' + (kind ? ' pap-wire-' + kind : '') });
+	}
+
+	var board = E('div', { 'class': 'pap-board' }, [
+		E('div', { 'class': 'pap-grid pap-port-row' }, [
+			node('gsw', 'jack', null, true), node('wan', 'jack'), node('lan2', 'jack')
+		]),
+		E('div', { 'class': 'pap-grid pap-traces' }, [
+			E('div', {}, [wire(), E('span', { 'class': 'pap-route-label' }, _('GSW switch')), wire()]),
+			E('div', {}, wire('uplink')), E('div', {}, wire())
+		]),
+		E('section', { 'class': 'pap-package' }, [
+			E('h4', {}, [nodeIcon('chip'), 'Airoha AN7581']),
+			E('div', { 'class': 'pap-grid' }, [
+				node('gdm1', 'path'), node('gdm2', 'path'), node('gdm4', 'path')
+			]),
+			E('div', { 'class': 'pap-grid' }, [
+				node('pse', 'buffer'), node('ppe', 'path'), node('npu', 'chip')
+			]),
+			E('div', { 'class': 'pap-grid pap-observations' }, [
+				node('cdm1', 'probe'), node('cdm2', 'probe'), node('cpu', 'chip'), node('crypto', 'lock')
+			])
+		]),
+		E('div', { 'class': 'pap-lanes' }, [
+			E('div', {}, [wire('radio'), node('pcie0', 'path'), wire('radio')]),
+			E('div', {}, [wire('radio'), node('pcie2', 'path'), wire('radio')])
+		]),
+		E('section', { 'class': 'pap-package pap-radio' }, [
+			E('h4', {}, [nodeIcon('radio'), 'MediaTek MT7996']),
+			E('div', { 'class': 'pap-grid' }, [
+				node('radio0', 'radio'), node('radio1', 'radio'), node('radio2', 'radio')
+			])
+		])
+	]);
+	var root = E('section', { 'class': 'pure-ap-board' }, [
+		E('h3', {}, _('Hardware layout')),
+		E('div', { 'class': 'pap-controls' }, [
+			E('label', {}, [E('span', {}, _('Layer 2 hardware offload (bridger)')), bridgeInput]),
+			E('label', {}, [E('span', {}, _('Wi-Fi NPU TX mapping')), mapInput])
+		]),
+		E('p', { 'class': 'pap-caption' }, _('Changes apply until reboot. Select a component for details.')),
+		board,
+		E('div', { 'class': 'pap-inspector', 'aria-live': 'polite' }, [selectedTitle, selectedText, selectedValue])
+	]);
+
+	function updateControls() {
+		bridgeInput.checked = status.bridger_running === true;
+		bridgeInput.disabled = !ready || pending || status.bridger_available !== true;
+		mapInput.value = lanes[status.tx_map] ? String(status.tx_map) : '';
+		mapInput.disabled = !ready || pending || status.map_available !== true;
+		board.classList.toggle('pap-offload-active', status.bridger_running === true);
+		var mapping = lanes[status.tx_map];
+		[0, 2].forEach(function(lane, index) {
+			var key = 'pcie' + lane;
+			var mapped = mapping ? mapping[index] : [];
+			var label = mapped.map(function(band) { return bands[band]; }).join(' / ');
+			metrics[key] = mapping ? _('NPU TX → %s').format(label + ' GHz') : '—';
+			nodes[key].value.textContent = metrics[key];
+			mapped.forEach(function(band) { nodes['radio' + band].tx.textContent = 'NPU TX · PCIe' + lane; });
+		});
+		if (!mapping) [0, 1, 2].forEach(function(band) { nodes['radio' + band].tx.textContent = ''; });
+		updateSelection();
+	}
+
+	function refresh() {
+		var request = ++generation;
+		return callStatus().then(function(value) {
+			if (pending || request !== generation) return;
+			ready = !!value && value.supported === true;
+			if (ready) status = value;
+			updateControls();
+		}, function() {
+			if (!pending && request === generation) {
+				ready = false;
+				updateControls();
+			}
+		});
+	}
+
+	function confirmChange(control, value) {
+		updateControls();
+		ui.showModal(_('Change hardware offload'), [
+			E('p', {}, _('This updates the running AP and may briefly interrupt accelerated traffic. Settings return to their startup state on reboot.')),
+			E('div', { 'class': 'right' }, [
+				E('button', { 'class': 'btn', 'type': 'button', 'click': ui.hideModal }, _('Cancel')),
+				' ',
+				E('button', { 'class': 'btn cbi-button-action', 'type': 'button', 'click': function() {
+					ui.hideModal();
+					pending = true;
+					generation++;
+					updateControls();
+					callSet(control, value).then(function(result) {
+						if (!result || result.error || result.supported !== true)
+							throw new Error(result && result.error ? result.error : _('No reply from AP'));
+						status = result;
+					}).catch(function(error) {
+						ui.addNotification(null, E('p', {}, _('Offload change failed: %s').format(error.message)));
+					}).finally(function() {
+						pending = false;
+						ready = false;
+						updateControls();
+						refresh();
+					});
+				} }, _('Apply'))
+			])
+		]);
+	}
+
+	bridgeInput.addEventListener('change', function() { confirmChange('bridger', bridgeInput.checked ? 1 : 0); });
+	mapInput.addEventListener('change', function() { confirmChange('tx_map', Number(mapInput.value)); });
+
+	function update(st, ppe, topo, wifi, fe, crypto) {
+		var ports = topo.ports || [];
+		var macs = fe.gdm || [];
+		var cdms = fe.cdm || [];
+		function find(list, field, value) {
+			return list.find(function(item) { return item && item[field] === value; }) || {};
+		}
+		var wan = find(ports, 'netdev', 'wan');
+		var lan2 = find(ports, 'netdev', 'lan2');
+		var switchPorts = ['lan3', 'lan4'].map(function(name) { return find(ports, 'netdev', name); });
+		metrics.gsw = 'LAN3 ' + portState(switchPorts[0]) + ' · LAN4 ' + portState(switchPorts[1]);
+		metrics.wan = ([portState(wan), status.wan_in_bridge ? 'br-lan' : ''].filter(Boolean)).join(' · ');
+		metrics.lan2 = portState(lan2);
+		board.classList.toggle('pap-link-up', wan.carrier === 1);
+
+		[1, 2, 4].forEach(function(reg) {
+			var row = find(macs, 'reg', reg);
+			metrics['gdm' + reg] = 'RX ' + num(row.rx) + ' · TX ' + num(row.tx);
+			if (reg === 4 && typeof row.rx_drop === 'number')
+				metrics.gdm4 += ' · ' + _('RX drops %s').format(num(row.rx_drop));
+		});
+
+		[1, 2].forEach(function(reg) {
+			var row = find(cdms, 'reg', reg);
+			var cpu = Number(row.rx_cpu) || 0, hardware = Number(row.rx_hwf) || 0;
+			metrics['cdm' + reg] = _('HW %s · CPU %s · %s since boot').format(num(row.rx_hwf), num(row.rx_cpu), ratio(hardware, cpu + hardware));
+		});
+
+		if (fe.pse) {
+			var total = Number(fe.pse.used) + Number(fe.pse.free);
+			var peak = fe.pse.peak == null ? '—' : ratio(fe.pse.peak, total);
+			metrics.pse = _('Current %s · peak %s').format(ratio(fe.pse.used, total), peak);
+		} else metrics.pse = '—';
+		var bound = ppe.bound == null ? st.offload_bound : ppe.bound;
+		var totalEntries = ppe.total == null ? st.offload_total : ppe.total;
+		metrics.ppe = num(bound) + ' BND / ' + num(totalEntries);
+		metrics.npu = st.npu_clock > 0 ? Math.round(st.npu_clock / 1000000) + ' MHz · ' + _('Cores %s').format(num(st.npu_cores)) : '—';
+		metrics.cpu = st.cpu_temp || '—';
+		metrics.crypto = crypto && typeof crypto.sessions === 'number' ? _('Active sessions %s').format(num(crypto.sessions)) : '—';
+
+		[0, 1, 2].forEach(function(band) {
+			var row = find(wifi.bands || [], 'band', band);
+			var tx = Number(row.tx_packets) || 0, retries = Number(row.tx_retries) || 0;
+			var rf = status.radios && status.radios[band];
+			var channel = rf ? 'CH ' + rf.channel + ' · ' + rf.width + ' MHz · ' : '';
+			metrics['radio' + band] = row.stations == null ? '—' : channel + _('Clients %s · cumulative retry %s').format(num(row.stations), ratio(retries, tx + retries));
+			if (row.stations > 0 && typeof row.avg_signal === 'number' && typeof row.min_signal === 'number')
+				metrics['radio' + band] += ' · ' + _('Signal %s / %s dBm').format(row.avg_signal, row.min_signal);
+		});
