From: Phase G <phaseG@local>
Subject: [PATCH] wifi: mt76: mt7996: fix EHT320 beamforming, HE BW320 MCS, and rc_work BF sync

1. In mt7996_mcu_sta_he_tlv(), handle IEEE80211_STA_RX_BW_320 alongside
   IEEE80211_STA_RX_BW_160 so 320 MHz EHT stations also populate
   he->max_nss_mcs[CMD_HE_MCS_BW160].
2. In mt7996_mcu_sta_bfer_he(), clamp bf->ncol_gt_bw80 against
   bf->nrow_gt_bw80.
3. In mt7996_mcu_sta_bfer_eht():
   - Populate ng16_su, ng16_mu, codebook42_su, codebook75_mu from EHT PHY cap.
   - Fall through from IEEE80211_STA_RX_BW_320 into IEEE80211_STA_RX_BW_160 so
     both the 320 MHz upper nibble [7:4] and 160 MHz lower nibble [3:0] of
     bf->nrow_gt_bw80 and bf->ncol_gt_bw80 are populated and clamped to nrow.
4. Keep bf->bw = link_sta->bandwidth (4 for 320 MHz), matching MT7996 WM
   firmware DBW enum verified via MT_ETBF_RX_FB_CONT(2) = BW320.
5. Add concise dev_info() in mt7996_mcu_sta_bfer_tlv() to observe negotiated
   STA_REC_BF parameters in dmesg.
6. In mt7996_mcu_add_rate_ctrl(), refresh STA_REC_BF before STA_REC_HE_V2
   when changed is set (e.g., BW/NSS/OM Control transitions).

---
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -1697,6 +1697,7 @@
 
 	mcs_map = link_sta->he_cap.he_mcs_nss_supp;
 	switch (link_sta->bandwidth) {
+	case IEEE80211_STA_RX_BW_320:
 	case IEEE80211_STA_RX_BW_160:
 		if (elem->phy_cap_info[0] &
 		    IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_80PLUS80_MHZ_IN_5G)
@@ -2100,6 +2101,7 @@
 		     pe->phy_cap_info[4]);
 
 	bf->nrow_gt_bw80 = min_t(int, snd_dim, sts);
+	bf->ncol_gt_bw80 = min_t(u8, bf->ncol_gt_bw80, bf->nrow_gt_bw80);
 }
 
 static void
@@ -2127,6 +2129,10 @@
 
 	bf->trigger_su = EHT_PHY(CAP3_TRIG_SU_BF_FDBK, pe->phy_cap_info[3]);
 	bf->trigger_mu = EHT_PHY(CAP3_TRIG_MU_BF_PART_BW_FDBK, pe->phy_cap_info[3]);
+	bf->ng16_su = EHT_PHY(CAP3_NG_16_SU_FEEDBACK, pe->phy_cap_info[3]);
+	bf->ng16_mu = EHT_PHY(CAP3_NG_16_MU_FEEDBACK, pe->phy_cap_info[3]);
+	bf->codebook42_su = EHT_PHY(CAP3_CODEBOOK_4_2_SU_FDBK, pe->phy_cap_info[3]);
+	bf->codebook75_mu = EHT_PHY(CAP3_CODEBOOK_7_5_MU_FDBK, pe->phy_cap_info[3]);
 	snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_80MHZ_MASK, ve->phy_cap_info[2]);
 	sts = EHT_PHY(CAP0_BEAMFORMEE_SS_80MHZ_MASK, pe->phy_cap_info[0]) +
 	      (EHT_PHY(CAP1_BEAMFORMEE_SS_80MHZ_MASK, pe->phy_cap_info[1]) << 1);
@@ -2140,17 +2146,9 @@
 		return;
 
 	switch (link_sta->bandwidth) {
-	case IEEE80211_STA_RX_BW_160:
-		snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_160MHZ_MASK, ve->phy_cap_info[2]);
-		sts = EHT_PHY(CAP1_BEAMFORMEE_SS_160MHZ_MASK, pe->phy_cap_info[1]);
-		nss_mcs = u8_get_bits(eht_nss->bw._160.rx_tx_mcs9_max_nss,
-				      IEEE80211_EHT_MCS_NSS_RX);
-		nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
+	case IEEE80211_STA_RX_BW_320: {
+		u8 nrow, ncol;
 
-		bf->nrow_gt_bw80 = min_t(u8, snd_dim, sts);
-		bf->ncol_gt_bw80 = nss_mcs;
-		break;
-	case IEEE80211_STA_RX_BW_320:
 		snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_320MHZ_MASK, ve->phy_cap_info[2]) +
 			  (EHT_PHY(CAP3_SOUNDING_DIM_320MHZ_MASK,
 				   ve->phy_cap_info[3]) << 2);
@@ -2159,9 +2157,27 @@
 				      IEEE80211_EHT_MCS_NSS_RX);
 		nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
 
-		bf->nrow_gt_bw80 = min_t(u8, snd_dim, sts) << 4;
-		bf->ncol_gt_bw80 = nss_mcs << 4;
+		nrow = min_t(u8, snd_dim, sts);
+		ncol = min_t(u8, nss_mcs, nrow);
+		bf->nrow_gt_bw80 |= nrow << 4;
+		bf->ncol_gt_bw80 |= ncol << 4;
+		fallthrough;
+	}
+	case IEEE80211_STA_RX_BW_160: {
+		u8 nrow, ncol;
+
+		snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_160MHZ_MASK, ve->phy_cap_info[2]);
+		sts = EHT_PHY(CAP1_BEAMFORMEE_SS_160MHZ_MASK, pe->phy_cap_info[1]);
+		nss_mcs = u8_get_bits(eht_nss->bw._160.rx_tx_mcs9_max_nss,
+				      IEEE80211_EHT_MCS_NSS_RX);
+		nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
+
+		nrow = min_t(u8, snd_dim, sts);
+		ncol = min_t(u8, nss_mcs, nrow);
+		bf->nrow_gt_bw80 |= nrow;
+		bf->ncol_gt_bw80 |= ncol;
 		break;
+	}
 	default:
 		break;
 	}
@@ -2242,6 +2258,13 @@
 			bf->mem_20m = bf->nrow < BF_MAT_ORDER ?
 				      matrix[bf->nrow][bf->ncol] : 0;
 	}
+
+	dev_info(dev->mt76.dev,
+		 "STA_REC_BF band=%u sta=%pM bw=%u ebf=%u cap=0x%x mode=%u nr=%u nc=%u gt80=0x%02x/0x%02x trig=%u/%u ng16=%u/%u cb=%u/%u\n",
+		 phy->mt76->band_idx, link_sta->addr, bf->bw, ebf, bf->bf_cap,
+		 bf->tx_mode, bf->nrow, bf->ncol, bf->nrow_gt_bw80,
+		 bf->ncol_gt_bw80, bf->trigger_su, bf->trigger_mu,
+		 bf->ng16_su, bf->ng16_mu, bf->codebook42_su, bf->codebook75_mu);
 }
 
 static void
@@ -2746,8 +2769,10 @@
 	 * once dev->rc_work changes the settings driver should also
 	 * update sta_rec_he here.
 	 */
-	if (changed)
+	if (changed) {
+		mt7996_mcu_sta_bfer_tlv(dev, skb, link_conf, link_sta, link);
 		mt7996_mcu_sta_he_tlv(skb, link_sta, link);
+	}
 
 	/* sta_rec_ra accommodates BW, NSS and only MCS range format
 	 * i.e 0-{7,8,9} for VHT.
